{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=lottery.db"
  },
  "Ocr": {
    "Engine": "onnx",
    "LocalPreprocess": "Original",
    "RetryPreprocess": "Contrast",
    "RetryStrategy": "Lines",
    "Onnx": {
      "NumThread": 0,
      "DoAngle": false,
      "ImgResize": 768,
      "RecParallelism": 0
    },
    "Validation": {
      "MinConfidence": 0.80,
      "MaxDaysPast": 60,
      "MaxDaysAhead": 14
    }
  },
  "Tesseract": {
    "DataPath": "./tessdata",
    "Languages": "vie+eng",
    "WarmupEngines": 3
  },
  "CloudOcr": {
    "Enabled": true,
    "Provider": "OcrSpace",
    "Endpoint": "https://api.ocr.space/parse/image",
    "ApiKey": "",
    "Language": "eng",
    "Engine": 2,
    "OnlyForTicketNumber": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  }
}