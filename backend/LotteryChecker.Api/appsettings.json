{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=lottery.db"
  },
  "Tesseract": {
    "DataPath": "./tessdata"
  },
  "CloudOcr": {
    "Enabled": true,
    "Provider": "OcrSpace",
    "Endpoint": "https://api.ocr.space/parse/image",
    "ApiKey": "helloworld",
    "Language": "eng",
    "Engine": 2
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  }
}